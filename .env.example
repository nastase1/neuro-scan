# API / Auth settings
CONNECTION_STRING=Data Source=/app/data/neuroscan.db
JWT_KEY=YourSuperSecretKeyThatIsAtLeast32CharactersLong123456
JWT_ISSUER=NeuroScanAPI
JWT_AUDIENCE=NeuroScanClient

# Python AI service endpoint inside Docker network
PYTHON_AI_URL=http://python-ai:8000

# Storage paths inside API container
STORAGE_UPLOAD_PATH=/app/uploads/scans
STORAGE_TRAINING_PATH=/app/uploads/training-data

# OpenAI API Key for medical report generation
OPENAI_API_KEY=sk-your-openai-key-here

# Email settings used by forgot-password flow
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@example.com
SMTP_FROM_NAME=NeuroScan
