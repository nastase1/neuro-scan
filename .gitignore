## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/
.vscode/
.idea/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Rider
.idea/
*.sln.iml

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
**/Properties/launchSettings.json

# StyleCop
StyleCopReport.xml

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*_results.xml
TestResult.xml
nunit-*.xml

# Coverage reports
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
*.lcov
.nyc_output

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.assets.json

# SQLite Database
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Migrations (uncomment if you don't want to track migrations)
# **/Migrations/

# Environment variables
.env
.env.*
!.env.example
*.env.local
*.env.production

# Uploads and user data
uploads/
upload/
wwwroot/uploads/
*.nii
*.nii.gz

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
*.egg
*.egg-info/
dist/
build/
.pytest_cache/
.tox/
.coverage
htmlcov/
.mypy_cache/
.dmypy.json
dmypy.json

# Docker
docker-compose.override.yml
.dockerignore

# Node (if using for frontend)
node_modules/
npm-debug.log
yarn-error.log
package-lock-json

# IDE
*.swp
*.swo
*~
.project
.classpath
.c9/
.settings/
.loadpath

